<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Global Zero-Trust Policy: Block unencrypted HTTP cleartext traffic while trusting standard HTTPS certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
